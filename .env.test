# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> league/oauth2-server-bundle ###
# The test environment gets its OWN keypair, and this block is the reason why.
#
# `.env.local` is NOT loaded when APP_ENV=test — Dotenv skips it by design — so the real
# passphrase an operator keeps there can never reach a test run. And League's CryptKey decrypts
# the private key in its CONSTRUCTOR (vendor/league/oauth2-server/src/CryptKey.php:74), not when
# it signs: every request that instantiates the AuthorizationServer therefore fails with an opaque
# "Unable to read key from file", including one that only expects a 400. With a single keypair,
# a protected dev key and a green suite are mutually exclusive.
#
# A second pair, generated by `make oauth-keys-test` with the pinned passphrase below, resolves
# that: the dev key stays genuinely protected and the suite stays green. Both files are already
# git-ignored by the /config/oauth/*.pem rule. This mirrors ci.yml, which generates a throwaway
# pair with the same pinned passphrase before PHPUnit.
#
# Nothing here is a secret, and nothing here is ever used outside APP_ENV=test.
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/oauth/private_test.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/oauth/public_test.pem
OAUTH_PASSPHRASE=test
# >= 32 characters, per the note in .env. Encrypts the authorization codes and refresh tokens
# league hands to a client, so a test that exercises the full flow needs it non-empty.
OAUTH_ENCRYPTION_KEY=test-only-never-a-real-secret-0000000000
###< league/oauth2-server-bundle ###

###> app/mcp-oauth-discovery ###
# WebTestCase requests default to host `localhost` with no port, so this is what the metadata
# documents and the `aud` claim must contain for the suite to assert their exact shape.
MCP_RESOURCE_URI=http://localhost/api/v1/mcp
###< app/mcp-oauth-discovery ###
