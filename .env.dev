###> app/mcp-oauth-discovery ###
# Port 8001 is where compose.yaml publishes the app, so this is the URI a local MCP client
# sends as its `resource` parameter. The path is the AUTHORING endpoint, not the public read one —
# see .env for why.
MCP_RESOURCE_URI=http://localhost:8001/api/v1/mcp-authoring
###< app/mcp-oauth-discovery ###
